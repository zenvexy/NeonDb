generator client {
  provider = "prisma-client-js"
}

// datasource db {
//    provider = "mysql"
// }

datasource db {
   provider = "postgresql"
}

model Esfiha {
  id          Int       @id @default(autoincrement())
  nome        String
  preco       Float
  disponivel  Disponibilidade @default(DISPONIVEL)
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
}

model Categoria {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  esfihas Esfiha[]
}

enum Disponibilidade {
  DISPONIVEL
  INDISPONIVEL
}